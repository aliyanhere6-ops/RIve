{
  "framework": null,
  "buildCommand": "node build.cjs",
  "outputDirectory": "dist",
  "headers": [
    {"source": "/vendor/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]}
  ]
}
